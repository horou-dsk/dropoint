{
  "name": "dropoint",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"cargo run -- --port 3000\" \"pnpm --dir web exec vite --host 0.0.0.0\"",
    "check": "cargo check",
    "format:check": "cargo fmt --all -- --check",
    "lint": "cargo clippy --all-targets --all-features -- -D warnings",
    "test": "cargo test",
    "web:dev": "pnpm --dir web dev",
    "web:build": "pnpm --dir web build",
    "web:test": "pnpm --dir web test"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
